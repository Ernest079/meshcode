{
  "name": "meshcode",
  "version": "0.0.0",
  "private": true,
  "description": "Write 3D models as code and turn them into GLB, or turn GLB back into code. Plus a benchmark: files vs hybrid vs pure-code games.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "meshcode": "node src/cli.mjs",
    "build:runtime": "vite build -c web/vite.runtime.config.js --logLevel warn",
    "dev": "pnpm build:runtime && vite -c web/vite.config.js",
    "build": "pnpm build:runtime && vite build -c web/vite.config.js",
    "preview": "vite preview -c web/vite.config.js",
    "test": "node --test test/*.test.mjs",
    "demo:gif": "node scripts/demo-gif.mjs",
    "bench:build": "node bench/build.mjs",
    "bench:check": "node bench/equivalence.mjs",
    "bench:static": "node bench/static.mjs",
    "bench:real": "node bench/real/gate.mjs",
    "bench:run": "node bench/run.mjs",
    "bench:preview": "vite preview --config bench/vite.config.js --port 4173"
  },
  "keywords": [
    "three.js",
    "glb",
    "gltf",
    "procedural",
    "3d",
    "codegen",
    "benchmark"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.65.1",
    "three": "0.187.0"
  },
  "bin": {
    "meshcode": "src/cli.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@tailwindcss/vite": "4.3.5",
    "codemirror": "6.0.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  }
}
